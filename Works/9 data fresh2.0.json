        "jsCode": "const items = $input.all();\nconst config = $node['Set Config'].json;\nconst maxBase64Bytes = config.maxBase64Bytes || 19922944;\nconst results = [];\n\nfor (let i = 0; i < items.length; i++) {\n  let base64 = '';\n  let mimeType = 'image/jpeg';\n  let base64SizeBytes = 0;\n\n  if (items[i].binary && items[i].binary.data) {\n    const buffer = await this.helpers.getBinaryDataBuffer(i, 'data');\n    base64 = buffer.toString('base64');\n    mimeType = items[i].binary.data.mimeType || 'image/jpeg';\n    base64SizeBytes = base64.length;\n  }\n\n  results.push({\n    json: {\n      ...items[i].json,\n      _base64: base64,\n      _mimeType: mimeType,\n      _base64SizeBytes: base64SizeBytes,\n      _maxBase64Bytes: maxBase64Bytes\n    }\n  });\n}\n\nreturn results;"
