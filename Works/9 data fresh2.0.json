      "parameters": {
        "jsCode": "const config = $node['Set Config'].json;\nconst startRow = config.startRow || 0;\nconst endRow = config.endRow || 0;\nconst forceReprocess = config.forceReprocess || false;\nconst maxFileSize = config.maxFileSizeBytes || 15728640;\n\nconst supportedTypes = new Set(['image/jpeg', 'image/png']);\n\nconst discovery = $items('Sheets - Read Discovery', 0, 0).map((item, index) => ({\n  ...item.json,\n  row_number: index + 1\n}));\nconst existing = $items('Sheets - Read Level1 (Existing)', 0, 0).map(i => i.json);\nconst completedIds = new Set(existing.map(r => String(r.image_id || '')).filter(Boolean));\n\nlet filtered = discovery;\n\nif (startRow > 0) {\n  const start = startRow - 1;\n  const end = endRow > 0 ? endRow : filtered.length;\n  filtered = filtered.slice(start, end);\n}\n\nif (!forceReprocess) {\n  filtered = filtered.filter(r => r.image_id && !completedIds.has(String(r.image_id)));\n} else {\n  filtered = filtered.filter(r => r.image_id);\n}\n\nfiltered = filtered.filter(r => supportedTypes.has(r.mime_type));\nfiltered = filtered.filter(r => (Number(r.file_size_bytes) || 0) <= maxFileSize);\n\nreturn filtered.map(r => ({ json: { ...r } }));"
      },
