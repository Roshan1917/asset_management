    {
      "parameters": {
        "jsCode": "const modelResponse = $json.choices?.[0]?.message?.content || '{}';\nlet parsed = {};\ntry {\n  parsed = JSON.parse(modelResponse);\n} catch {\n  parsed = { heading: null, description: null, general_classification: null, sub_classification: null, tags: null, color_classification: null };\n}\n\nconst srcNode = $('Prepare L1 Azure Payload').first();\nconst src = srcNode ? srcNode.json : {};\n\nconst usage = $json.usage || {};\nconst promptTokens = usage.prompt_tokens ?? 0;\nconst completionTokens = usage.completion_tokens ?? 0;\nconst totalTokens = usage.total_tokens ?? 0;\n\nconst model = $json.model || '';\nconst costPerMillionInput = {\n  'gpt-4.1-nano': 0.10,\n  'gpt-4o-mini-2024-07-18': 0.15,\n  'gpt-4o-mini': 0.15,\n  'gpt-4.1-mini': 0.40,\n  'gpt-4o-2024-08-06': 2.50,\n  'gpt-4o': 2.50\n};\nconst costPerMillionOutput = {\n  'gpt-4.1-nano': 0.40,\n  'gpt-4o-mini-2024-07-18': 0.60,\n  'gpt-4o-mini': 0.60,\n  'gpt-4.1-mini': 1.60,\n  'gpt-4o-2024-08-06': 10.00,\n  'gpt-4o': 10.00\n};\n\nlet inputRate = 0;\nlet outputRate = 0;\nfor (const key of Object.keys(costPerMillionInput)) {\n  if (model.includes(key)) {\n    inputRate = costPerMillionInput[key];\n    outputRate = costPerMillionOutput[key];\n    break;\n  }\n}\n\nconst estimatedCostUsd = ((promptTokens * inputRate) + (completionTokens * outputRate)) / 1000000;\n\nreturn [{\n  json: {\n    row_number: src.row_number ?? null,\n    image_id: src.image_id ?? null,\n    file_name: src.file_name ?? null,\n    heading: parsed.heading || src.file_name || null,\n    description: parsed.description ?? null,\n    general_classification: parsed.general_classification ?? null,\n    sub_classification: parsed.sub_classification ?? null,\n    tags: parsed.tags ?? null,\n    color_classification: parsed.color_classification ?? null,\n    mime_type: src.mime_type ?? null,\n    file_size_bytes: src.file_size_bytes ?? null,\n    source_path: src.source_path ?? null,\n    folder_id: src.folder_id ?? null,\n    folder_order: src.folder_order ?? null,\n    image_url: src.image_url ?? null,\n    model_used: model,\n    prompt_tokens: promptTokens,\n    completion_tokens: completionTokens,\n    total_tokens: totalTokens,\n    estimated_cost_usd: estimatedCostUsd,\n    processed_at: new Date().toISOString()\n  }\n}];"
      },
