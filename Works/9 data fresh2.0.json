        "jsCode": "const items = $input.all();\nconst config = $node['Set Config'].json;\nconst maxFileSize = config.maxFileSizeBytes || 15728640;\nconst results = [];\n\nfor (let i = 0; i < items.length; i++) {\n  let actualSize = 0;\n  if (items[i].binary && items[i].binary.data) {\n    const buffer = await this.helpers.getBinaryDataBuffer(i, 'data');\n    actualSize = buffer.length;\n  }\n  results.push({\n    json: {\n      ...items[i].json,\n      _actualSizeBytes: actualSize,\n      _maxFileSizeBytes: maxFileSize\n    },\n    binary: items[i].binary\n  });\n}\n\nreturn results;"
