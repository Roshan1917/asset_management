    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (let i = 0; i < items.length; i++) {\n  const src = items[i].json;\n  const base64 = src._base64 || '';\n  const mimeType = src._mimeType || 'image/jpeg';\n\n  const { _base64, _mimeType, _base64SizeBytes, _maxBase64Bytes, _actualSizeBytes, _maxFileSizeBytes, ...metadata } = src;\n\n  const imageUrl = base64 ? 'data:' + mimeType + ';base64,' + base64 : '';\n\n  const userContent = [\n    {\n      type: 'text',\n      text:\n        'Analyze the provided image and generate JSON with exactly these keys:\\n' +\n        '- heading: short, professional title (3\\u20138 words)\\n' +\n        '- description: 1 sentence, max 25 words, neutral marketing tone\\n' +\n        '- general_classification: a broad category name (keep it concise; you may create/choose an appropriate broad bucket based on the image)\\n' +\n        '- sub_classification: a more specific category within the general_classification (e.g. if general is \\\"Product Photography\\\", sub could be \\\"Flat Lay\\\" or \\\"Lifestyle Shot\\\")\\n' +\n        '- tags: comma-separated list of 5\\u201310 relevant keywords for search (e.g. \\\"outdoor, sunset, corporate, team, building\\\")\\n' +\n        '- color_classification: dominant color palette or mood (e.g. \\\"Warm Tones\\\", \\\"Cool Blue\\\", \\\"Monochrome\\\", \\\"Vibrant Multi-color\\\", \\\"Earth Tones\\\")\\n\\n' +\n        'Filename: ' + (metadata.file_name || '') + '\\n\\n' +\n        'Rules:\\n' +\n        '- Keep wording consistent and business-friendly.\\n' +\n        '- If the image is abstract/unclear, use a reasonable broad classification and keep description generic.\\n' +\n        '- Output must be valid JSON.'\n    }\n  ];\n  if (imageUrl) {\n    userContent.push({ type: 'image_url', image_url: { url: imageUrl } });\n  }\n\n  const payload = {\n    temperature: 0.1,\n    response_format: { type: 'json_object' },\n    messages: [\n      {\n        role: 'system',\n        content:\n          'You are a visual asset cataloging assistant for a marketing team. ' +\n          'You will be given an image (and its filename). ' +\n          'Your job is to create professional, searchable metadata. ' +\n          'Return STRICT JSON ONLY (no markdown, no commentary). ' +\n          'Do not include extra keys beyond what is requested. ' +\n          'Do not guess sensitive attributes about people (identity, health, etc.).'\n      },\n      {\n        role: 'user',\n        content: userContent\n      }\n    ]\n  };\n\n  results.push({\n    json: {\n      ...metadata,\n      payload\n    }\n  });\n}\n\nreturn results;"
      },
