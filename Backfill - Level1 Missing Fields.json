    {
      "parameters": {
        "jsCode": "const modelResponse = $json.choices?.[0]?.message?.content || '{}';\nlet parsed = {};\ntry {\n  parsed = JSON.parse(modelResponse);\n} catch {\n  parsed = { sub_classification: null, tags: null, color_classification: null };\n}\n\nconst src = $('Prepare Backfill Payload').first().json;\n\nconst usage = $json.usage || {};\nconst promptTokens = usage.prompt_tokens ?? 0;\nconst completionTokens = usage.completion_tokens ?? 0;\nconst totalTokens = usage.total_tokens ?? 0;\n\nconst model = $json.model || '';\nconst costPerMillionInput = {\n  'gpt-4.1-nano': 0.10,\n  'gpt-4o-mini-2024-07-18': 0.15,\n  'gpt-4o-mini': 0.15,\n  'gpt-4.1-mini': 0.40,\n  'gpt-4o-2024-08-06': 2.50,\n  'gpt-4o': 2.50\n};\nconst costPerMillionOutput = {\n  'gpt-4.1-nano': 0.40,\n  'gpt-4o-mini-2024-07-18': 0.60,\n  'gpt-4o-mini': 0.60,\n  'gpt-4.1-mini': 1.60,\n  'gpt-4o-2024-08-06': 10.00,\n  'gpt-4o': 10.00\n};\n\nlet inputRate = 0;\nlet outputRate = 0;\nfor (const key of Object.keys(costPerMillionInput)) {\n  if (model.includes(key)) {\n    inputRate = costPerMillionInput[key];\n    outputRate = costPerMillionOutput[key];\n    break;\n  }\n}\n\nconst estimatedCostUsd = ((promptTokens * inputRate) + (completionTokens * outputRate)) / 1000000;\n\nreturn [{\n  json: {\n    image_id: src.image_id ?? null,\n    sub_classification: parsed.sub_classification ?? null,\n    tags: parsed.tags ?? null,\n    color_classification: parsed.color_classification ?? null,\n    model_used: model,\n    prompt_tokens: promptTokens,\n    completion_tokens: completionTokens,\n    total_tokens: totalTokens,\n    estimated_cost_usd: estimatedCostUsd,\n    processed_at: new Date().toISOString()\n  }\n}];"
      },
