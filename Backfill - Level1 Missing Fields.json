      "parameters": {
        "jsCode": "const config = $node['Set Config'].json;\nconst startRow = config.startRow || 0;\nconst endRow = config.endRow || 0;\nconst maxFileSize = config.maxFileSizeBytes || 15728640;\n\nconst supportedTypes = new Set(['image/jpeg', 'image/png']);\n\nconst level1 = $input.all().map((item, index) => ({\n  ...item.json,\n  row_number: index + 1\n}));\n\nlet filtered = level1;\n\nif (startRow > 0) {\n  const start = startRow - 1;\n  const end = endRow > 0 ? endRow : filtered.length;\n  filtered = filtered.slice(start, end);\n}\n\nfiltered = filtered.filter(r => r.image_id && (!r.sub_classification || String(r.sub_classification).trim() === ''));\nfiltered = filtered.filter(r => supportedTypes.has(r.mime_type));\nfiltered = filtered.filter(r => (Number(r.file_size_bytes) || 0) <= maxFileSize);\n\nreturn filtered.map(r => ({ json: { ...r } }));"
