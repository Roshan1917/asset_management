    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (let i = 0; i < items.length; i++) {\n  const src = items[i].json;\n  const base64 = src._base64 || '';\n  const mimeType = src._mimeType || 'image/jpeg';\n\n  const { _base64, _mimeType, _base64SizeBytes, _maxBase64Bytes, _actualSizeBytes, _maxFileSizeBytes, ...metadata } = src;\n\n  const imageUrl = base64 ? 'data:' + mimeType + ';base64,' + base64 : '';\n\n  const userContent = [\n    {\n      type: 'text',\n      text:\n        'You already have this context about the image:\\n' +\n        '- Heading: ' + (metadata.heading || '') + '\\n' +\n        '- Description: ' + (metadata.description || '') + '\\n' +\n        '- General Classification: ' + (metadata.general_classification || '') + '\\n' +\n        '- Filename: ' + (metadata.file_name || '') + '\\n\\n' +\n        'Now analyze the provided image and generate JSON with exactly these keys:\\n' +\n        '- sub_classification: a more specific category within the general_classification (e.g. if general is \\\"Product Photography\\\", sub could be \\\"Flat Lay\\\" or \\\"Lifestyle Shot\\\")\\n' +\n        '- tags: comma-separated list of 5\\u201310 relevant keywords for search (e.g. \\\"outdoor, sunset, corporate, team, building\\\")\\n' +\n        '- color_classification: dominant color palette or mood (e.g. \\\"Warm Tones\\\", \\\"Cool Blue\\\", \\\"Monochrome\\\", \\\"Vibrant Multi-color\\\", \\\"Earth Tones\\\")\\n\\n' +\n        'Rules:\\n' +\n        '- Keep wording consistent and business-friendly.\\n' +\n        '- If the image is abstract/unclear, use a reasonable classification and keep tags generic.\\n' +\n        '- Output must be valid JSON.'\n    }\n  ];\n  if (imageUrl) {\n    userContent.push({ type: 'image_url', image_url: { url: imageUrl } });\n  }\n\n  const payload = {\n    temperature: 0.1,\n    response_format: { type: 'json_object' },\n    messages: [\n      {\n        role: 'system',\n        content:\n          'You are a visual asset cataloging assistant for a marketing team. ' +\n          'You will be given an image along with its existing metadata (heading, description, general classification). ' +\n          'Your job is to add deeper classification, tags, and color analysis. ' +\n          'Return STRICT JSON ONLY (no markdown, no commentary). ' +\n          'Do not include extra keys beyond what is requested.'\n      },\n      {\n        role: 'user',\n        content: userContent\n      }\n    ]\n  };\n\n  results.push({\n    json: {\n      ...metadata,\n      payload\n    }\n  });\n}\n\nreturn results;"
      },
