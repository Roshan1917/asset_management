    {
      "parameters": {
        "jsCode": "const discovery = $items('Sheets - Read Discovery', 0, 0).map(i => i.json);\nconst existing = $items('Sheets - Read Level1 (Existing)', 0, 0).map(i => i.json);\nconst completedIds = new Set(existing.map(r => String(r.image_id || '')).filter(Boolean));\n\nreturn discovery\n  .filter(r => r.image_id && !completedIds.has(String(r.image_id)))\n  .map(r => ({\n    json: {\n      ...r,\n      azure_endpoint: $node['Set Config'].json.azureEndpoint,\n      azure_api_key: $node['Set Config'].json.azureApiKey\n    }\n  }));"
      },
      "id": "build_l1_queue",
      "name": "Build L1 Queue (Skip Existing image_id)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -440,
        300
      ]
    },
