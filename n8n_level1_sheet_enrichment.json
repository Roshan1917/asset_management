              "value": "application/json"
            },
            {
              "name": "api-key",
              "value": "={{$json.azure_api_key}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{$json.payload}}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "azure_l1_sheet",
      "name": "Azure OpenAI - L1 Classification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const modelResponse = $json.choices?.[0]?.message?.content || '{}';\nlet parsed = {};\ntry {\n  parsed = JSON.parse(modelResponse);\n} catch {\n  parsed = { heading: null, description: null, general_classification: null };\n}\n\nconst src = $items('Prepare L1 Azure Payload', 0, 0)[0].json;\n\nreturn [{\n  json: {\n    image_id: src.image_id,\n    file_name: src.file_name,\n    heading: parsed.heading || src.file_name,\n    description: parsed.description || null,\n    general_classification: parsed.general_classification || null,\n    mime_type: src.mime_type || null,\n    file_size_bytes: src.file_size_bytes || null,\n    source_path: src.source_path || null,\n    folder_id: src.folder_id || null,\n    folder_order: src.folder_order || null,\n    image_url: src.image_url || null,\n    processed_at: new Date().toISOString()\n  }\n}];"
      },
