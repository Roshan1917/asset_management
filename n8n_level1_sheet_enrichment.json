        "googleDriveOAuth2Api": {
          "id": "REPLACE_AT_IMPORT",
          "name": "Google Drive OAuth2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const src = $items('Split In Batches (L1)', 0, 0)[0].json;\n\nconst payload = {\n  model: 'gpt-4.1-nano',\n  temperature: 0.1,\n  response_format: { type: 'json_object' },\n  messages: [\n    {\n      role: 'system',\n      content: 'You are an image catalog assistant. Return strict JSON only.'\n    },\n    {\n      role: 'user',\n      content: [\n        {\n          type: 'text',\n          text: `Create JSON with keys: heading, description, general_classification. Keep heading short and description max 25 words. File name: ${src.file_name || ''}.`\n        },\n        {\n          type: 'input_image',\n          image_base64: $binary.data.data\n        }\n      ]\n    }\n  ]\n};\n\nreturn [{\n  json: {\n    ...src,\n    payload,\n    azure_endpoint: src.azure_endpoint,\n    azure_api_key: src.azure_api_key\n  }\n}];"
      },
      "id": "prepare_payload_l1_sheet",
      "name": "Prepare L1 Azure Payload",
      "type": "n8n-nodes-base.code",
