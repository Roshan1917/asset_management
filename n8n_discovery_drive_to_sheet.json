{
  "name": "Asset Marketing - Discovery (Drive to Google Sheet)",
  "nodes": [
    {
      "parameters": {},
      "id": "manual_trigger_discovery",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -1080,
        280
      ]
    },
    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "{\n  \"spreadsheetId\": \"1bSdv2uqqvOqqg8zTGQAjHC4b6P4SS2chNt8iltit6t4\",\n  \"sheetNameDiscovery\": \"Discovery\"\n}"
      },
      "id": "set_config_discovery",
      "name": "Set Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -860,
        280
      ]
    },
    {
      "parameters": {
        "resource": "fileFolder",
        "operation": "search",
        "queryString": "('1vrNekG1Qr56NK1QjgFO2uocib1KKbnxU' in parents) and trashed = false",
        "returnAll": true,
        "options": {
          "fields": "files(id,name,mimeType,parents)"
        }
      },
      "id": "drive_list_root_contents",
      "name": "Drive - List Root Folder Contents",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        -720,
        280
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "REPLACE_AT_IMPORT",
          "name": "Google Drive OAuth2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const config = $node['Set Config'].json;\nconst all = $input.all().map(i => i.json);\nconst rootId = (all.length && all[0].parents && all[0].parents[0]) ? all[0].parents[0] : null;\nif (!rootId) return [];\nconst subfolders = all\n  .filter(f => f.mimeType === 'application/vnd.google-apps.folder')\n  .map(f => ({ id: f.id, name: (f.name || '').toLowerCase() }))\n  .sort((a, b) => a.name.localeCompare(b.name));\nconst queue = [\n  { folder_id: rootId, folder_order: 1 },\n  ...subfolders.map((f, i) => ({ folder_id: f.id, folder_order: i + 2 }))\n];\nreturn queue.map(f => ({\n  json: {\n    spreadsheetId: config.spreadsheetId,\n    sheetNameDiscovery: config.sheetNameDiscovery,\n    folder_id: f.folder_id,\n    folder_order: f.folder_order\n  }\n}));"
      },
      "id": "build_folder_queue",
      "name": "Build Folder Queue",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -640,
        280
      ]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "split_folders",
      "name": "Split In Batches - Folder Queue",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        -420,
        280
      ]
    },
    {
      "parameters": {
        "resource": "fileFolder",
        "operation": "search",
        "queryString": "mimeType contains 'image/' and trashed = false and ('{{$json.folder_id}}' in parents)",
        "returnAll": true,
        "options": {
          "fields": "files(id,name,mimeType,size,parents,webViewLink,imageMediaMetadata(width,height),createdTime,modifiedTime)"
        }
      },
      "id": "drive_search_by_folder",
      "name": "Drive - Search Images in Folder",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        -200,
        280
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "REPLACE_AT_IMPORT",
          "name": "Google Drive OAuth2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nif (!items.length) {\n  return [];\n}\n\nconst folderCtx = $items('Split In Batches - Folder Queue', 0, 0)[0].json;\n\nreturn items.map(item => ({\n  json: {\n    folder_order: folderCtx.folder_order,\n    folder_id: folderCtx.folder_id,\n    image_id: item.json.id,\n    file_name: item.json.name,\n    image_url: item.json.webViewLink || null,\n    mime_type: item.json.mimeType || null,\n    file_size_bytes: item.json.size || null,\n    source_path: `drive_parent:${folderCtx.folder_id}`,\n    discovered_at: new Date().toISOString()\n  }\n}));"
      },
      "id": "normalize_discovery_rows",
      "name": "Normalize Discovery Rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        20,
        280
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "={{$node['Set Config'].json['spreadsheetId']}}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "={{$node['Set Config'].json['sheetNameDiscovery']}}"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {},
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {}
      },
      "id": "append_discovery_sheet",
      "name": "Sheets - Append Discovery",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        260,
        280
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_AT_IMPORT",
          "name": "Google Sheets OAuth2"
        }
      }
    },
    {
      "parameters": {},
      "id": "next_folder",
      "name": "Next Folder",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        500,
        280
      ]
    }
  ],
