      "id": "azure_l2_sheet",
      "name": "Azure OpenAI - L2 Enrichment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const modelResponse = $json.choices?.[0]?.message?.content || '{}';\nlet parsed = {};\ntry {\n  parsed = JSON.parse(modelResponse);\n} catch {\n  parsed = { sub_classification: null, tags: [], color_classification: [] };\n}\n\nconst src = $items('Prepare L2 Azure Payload', 0, 0)[0].json;\n\nreturn [{\n  json: {\n    image_id: src.image_id,\n    file_name: src.file_name,\n    heading: src.heading,\n    description: src.description,\n    general_classification: src.general_classification,\n    sub_classification: parsed.sub_classification || null,\n    tags: Array.isArray(parsed.tags) ? parsed.tags.join('|') : null,\n    color_classification: Array.isArray(parsed.color_classification) ? parsed.color_classification.join('|') : null,\n    mime_type: src.mime_type || null,\n    file_size_bytes: src.file_size_bytes || null,\n    source_path: src.source_path || null,\n    folder_id: src.folder_id || null,\n    folder_order: src.folder_order || null,\n    image_url: src.image_url || null,\n    processed_at: new Date().toISOString()\n  }\n}];"
      },
