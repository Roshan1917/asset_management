    {
      "parameters": {
        "jsCode": "const level1 = $items('Sheets - Read Level1', 0, 0).map(i => i.json);\nconst level2Existing = $items('Sheets - Read Level2 (Existing)', 0, 0).map(i => i.json);\nconst completedIds = new Set(level2Existing.map(r => String(r.image_id || '')).filter(Boolean));\n\nreturn level1\n  .filter(r => r.image_id && !completedIds.has(String(r.image_id)))\n  .map(r => ({\n    json: {\n      ...r,\n      azure_endpoint: $node['Set Config'].json.azureEndpoint,\n      azure_api_key: $node['Set Config'].json.azureApiKey\n    }\n  }));"
      },
      "id": "build_l2_queue",
      "name": "Build L2 Queue (Skip Existing image_id)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
