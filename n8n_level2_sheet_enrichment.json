    {
      "parameters": {
        "jsCode": "const src = $items('Split In Batches (L2)', 0, 0)[0].json;\n\nconst payload = {\n  model: 'gpt-4.1-nano',\n  temperature: 0.1,\n  response_format: { type: 'json_object' },\n  messages: [\n    {\n      role: 'system',\n      content: 'You enrich image metadata. Return strict JSON only.'\n    },\n    {\n      role: 'user',\n      content: [\n        {\n          type: 'text',\n          text: `Using this metadata, return JSON keys: sub_classification (string), tags (array 3-5 one-word lowercase tags), color_classification (array of dominant colors). Metadata: ${JSON.stringify(src)}`\n        },\n        {\n          type: 'input_image',\n          image_base64: $binary.data.data\n        }\n      ]\n    }\n  ]\n};\n\nreturn [{\n  json: {\n    ...src,\n    payload,\n    azure_endpoint: src.azure_endpoint,\n    azure_api_key: src.azure_api_key\n  }\n}];"
      },
      "id": "prepare_payload_l2_sheet",
      "name": "Prepare L2 Azure Payload",
